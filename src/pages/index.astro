---
import Base from '../layouts/Base.astro';
import CatPlanet from '../components/CatPlanet.astro';
import ArticleCard from '../components/ArticleCard.astro';
import TopicIcon from '../components/TopicIcon.astro';
import { getCollection } from 'astro:content';
import { SITE, u, formatDate, isoDate } from '../site';
import { TOPICS, topicNames } from '../topics';

const articles = (await getCollection('articles')).sort((a, b) => +b.data.published - +a.data.published);
const diary = (await getCollection('diary')).sort((a, b) => +b.data.published - +a.data.published).slice(0, 3);
const counts = Object.fromEntries(topicNames.map((n) => [n, articles.filter((a) => a.data.category === n).length]));

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: new URL(u('/'), Astro.site).href,
  inLanguage: 'ja',
  publisher: { '@id': `${new URL(u('/'), Astro.site).href}#org` },
};
---
<Base title={SITE.name} jsonLd={[website]}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="badge">茶トラのテンとムギが暮らす、小さな惑星</p>
        <h1><span class="h1-sub">北九州・小倉の保護猫施設</span>ねこの惑星</h1>
        <p class="lead">ねこの惑星は、就労継続支援B型のメンバーと一緒に猫のお世話をしている保護猫施設です。殺処分ゼロを目指して、毎日の様子や猫との暮らしに役立つ情報を発信しています。</p>
        <p class="actions">
          <a class="btn" href={u('/visit/')}>見学を申し込む</a>
          <a class="btn-ghost" href={u('/cats/')}>テンとムギを見る</a>
        </p>
      </div>
      <div class="hero-art">
        <div class="sky"><CatPlanet /></div>
      </div>
    </div>
  </section>

  <nav class="wrap topics" aria-label="記事のトピック">
    <ul>
      {topicNames.filter((n) => counts[n] > 0).map((n) => (
        <li class={`tone-${TOPICS[n].tone}`}>
          <a href={u(`/articles/topic/${TOPICS[n].slug}/`)}>
            <TopicIcon icon={TOPICS[n].icon} size={40} />
            <span>{n}<small>{counts[n]}記事</small></span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <section class="wrap sec" aria-labelledby="cats-h">
    <div class="sec-head">
      <div><h2 id="cats-h">この惑星の住人</h2><p>どちらも茶トラのオス。性格はぜんぜん違います。</p></div>
      <a class="more" href={u('/cats/')}>プロフィールを見る</a>
    </div>
    <div class="cats">
      <a class="cat tone-peach" href={u('/cats/#ten')}>
        <span class="face" aria-hidden="true"></span>
        <span class="cat-body"><span class="cat-name">テン</span><span>TikTokライブの常連。施設の看板猫です。</span></span>
      </a>
      <a class="cat tone-mint" href={u('/cats/#mugi')}>
        <span class="face" aria-hidden="true"></span>
        <span class="cat-body"><span class="cat-name">ムギ</span><span>新しいおもちゃには全力で飛びつくタイプ。</span></span>
      </a>
      <a class="cat tone-lilac follow" href={SITE.sns[0].url}>
        <span class="cat-body"><span class="cat-name small">TikTokで毎日更新</span><span>フォロワー3,000人超え。2匹の動画を見る</span></span>
      </a>
    </div>
  </section>

  <section class="wrap sec" aria-labelledby="art-h">
    <div class="sec-head">
      <div><h2 id="art-h">保護猫のお役立ち記事</h2><p>迎える準備から北九州の地域情報まで。</p></div>
      <a class="more" href={u('/articles/')}>記事をすべて見る</a>
    </div>
    <div class="grid">
      {articles.slice(0, 6).map((a) => <ArticleCard id={a.id} {...a.data} />)}
    </div>
  </section>

  <section class="wrap sec" aria-labelledby="diary-h">
    <div class="sec-head">
      <div><h2 id="diary-h">テン・ムギ日記</h2><p>施設での2匹の毎日を、ゆるく記録しています。</p></div>
      <a class="more" href={u('/diary/')}>日記をすべて読む</a>
    </div>
    <ul class="diary">
      {diary.map((d) => (
        <li>
          <time datetime={isoDate(d.data.published)}><span>{d.data.published.getMonth() + 1}/{d.data.published.getDate()}</span>{d.data.published.getFullYear()}</time>
          <div><a href={u(`/diary/${d.id}/`)}>{d.data.title}</a><p>{d.data.description}</p></div>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap sec mission" aria-labelledby="mission-h">
    <div>
      <h2 id="mission-h">猫のお世話が、誰かの仕事になる場所</h2>
      <p>ねこの惑星は、就労継続支援B型事業所「ラシクラボ小倉」「ラシクラボ小倉鍛冶町」の利用者さんと職員が一緒に運営しています。ごはんやトイレ掃除、遊び相手、SNSでの発信、手書きの「ねこわく新聞」づくり。猫たちの毎日を支える仕事を、みんなで分け合っています。</p>
      <a class="btn-ghost" href={u('/about/')}>ねこの惑星について</a>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(2rem, 6vw, 4.5rem) 1rem; background: radial-gradient(60rem 30rem at 85% 20%, var(--lilac), transparent 60%), radial-gradient(40rem 26rem at 5% 90%, var(--peach), transparent 60%); }
  .hero-grid { display: grid; grid-template-columns: 1.15fr .85fr; align-items: center; gap: clamp(1.5rem, 4vw, 3.5rem); }
  .badge { display: inline-block; margin: 0 0 1rem; padding: .3rem .9rem; border-radius: 999px; background: var(--paper); border: 2px solid var(--line); font-size: .85rem; font-weight: 700; color: var(--ginger-ink); }
  .hero h1 { font-size: clamp(2.6rem, 7vw, 4.4rem); line-height: 1.15; margin-bottom: 1rem; letter-spacing: .08em; }
  .h1-sub { display: block; font-size: clamp(1rem, 1.8vw, 1.25rem); letter-spacing: .06em; color: var(--ink-soft); margin-bottom: .5rem; }
  .lead { color: var(--ink-soft); max-width: 32em; }
  .actions { display: flex; flex-wrap: wrap; gap: .9rem; margin-top: 1.6rem; }
  .sky { aspect-ratio: 1; display: grid; place-items: center; padding: 8%; border-radius: 42% 58% 52% 48% / 48% 44% 56% 52%; background: radial-gradient(circle at 30% 25%, #3d4785, var(--night)); box-shadow: 0 30px 60px -30px rgba(42, 51, 99, .55); }

  .topics ul { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: .8rem; }
  .topics a { display: flex; align-items: center; gap: .7rem; padding: .7rem 1rem .7rem .7rem; border-radius: var(--r-md); background: var(--tone); color: var(--tone-deep); text-decoration: none; font-weight: 700; transition: transform .15s; }
  .topics a:hover { transform: translateY(-2px); }
  .topics span { display: flex; flex-direction: column; line-height: 1.35; }
  .topics small { font-weight: 500; font-size: .78rem; opacity: .85; }

  .cats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .cat { display: flex; align-items: center; gap: 1rem; padding: 1.3rem; border-radius: var(--r-md); background: var(--tone); color: var(--ink); text-decoration: none; transition: transform .15s; }
  .cat:hover { transform: translateY(-3px); }
  .face { flex: none; width: 4.6rem; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #ffb466, var(--ginger) 62%, #d97520); position: relative; }
  .face::before, .face::after { content: ''; position: absolute; top: -.55rem; width: 1.5rem; aspect-ratio: 1; background: #f7a24f; clip-path: polygon(50% 0, 100% 100%, 0 100%); }
  .face::before { left: .35rem; transform: rotate(-16deg); }
  .face::after { right: .35rem; transform: rotate(16deg); }
  .cat-body { display: flex; flex-direction: column; font-size: .9rem; line-height: 1.7; color: var(--ink-soft); }
  .cat-name { font-family: var(--font-head); font-weight: 700; font-size: 1.6rem; color: var(--ink); line-height: 1.3; }
  .cat-name.small { font-size: 1.15rem; }
  .follow { border: 2px dashed var(--lilac-deep); background: var(--paper); }

  .diary { list-style: none; padding: 0; margin: 0; display: grid; gap: .8rem; }
  .diary li { display: flex; gap: 1.2rem; align-items: center; padding: 1rem 1.2rem; background: var(--paper); border: 2px solid var(--line); border-radius: var(--r-md); position: relative; }
  .diary li:hover { border-color: var(--ginger); }
  .diary time { flex: none; display: flex; flex-direction: column; align-items: center; justify-content: center; width: 4.4rem; aspect-ratio: 1; border-radius: 50%; background: var(--ginger-soft); color: var(--ginger-ink); font-size: .72rem; line-height: 1.2; }
  .diary time span { font-family: var(--font-head); font-weight: 700; font-size: 1.15rem; }
  .diary a { color: var(--ink); text-decoration: none; font-weight: 700; }
  .diary a::after { content: ''; position: absolute; inset: 0; }
  .diary p { margin: .1rem 0 0; color: var(--ink-soft); font-size: .9rem; line-height: 1.7; }

  .mission { background: var(--mint); border-radius: var(--r-lg); padding: clamp(1.8rem, 5vw, 3.2rem); }
  .mission > div { max-width: 40em; }
  .mission h2 { margin-bottom: .8rem; }

  .tone-peach { --tone: var(--peach); --tone-deep: var(--peach-deep); }
  .tone-mint { --tone: var(--mint); --tone-deep: var(--mint-deep); }
  .tone-lilac { --tone: var(--lilac); --tone-deep: var(--lilac-deep); }
  .tone-sky { --tone: var(--sky); --tone-deep: var(--sky-deep); }
  .tone-rose { --tone: var(--rose); --tone-deep: var(--rose-deep); }

  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-art { order: -1; width: min(18rem, 70%); margin-inline: auto; }
    .cats { grid-template-columns: 1fr; }
  }
</style>
