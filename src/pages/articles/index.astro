---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import TopicNav from '../../components/TopicNav.astro';
import { getCollection } from 'astro:content';
import { topicNames } from '../../topics';

const articles = (await getCollection('articles')).sort((a, b) => +b.data.published - +a.data.published);
const counts = Object.fromEntries(topicNames.map((n) => [n, articles.filter((a) => a.data.category === n).length]));
---
<Base title="保護猫のお役立ち記事" description="保護猫を迎える準備、新しい家に慣れるまでの過ごし方、室内飼いのコツ、北九州の保護猫事情など、保護猫施設ねこの惑星がまとめたお役立ち記事の一覧です。" crumbs={[{ name: 'お役立ち記事', path: '/articles/' }]}>
  <div class="wrap">
    <header class="page-head">
      <h1>保護猫のお役立ち記事</h1>
      <p>保護猫を迎える前に知っておきたいこと、一緒に暮らすコツ、北九州の情報をまとめています。</p>
    </header>
    <TopicNav counts={counts} />
    <div class="grid">
      {articles.map((a) => <ArticleCard id={a.id} {...a.data} />)}
    </div>
  </div>
</Base>
<style>
  .page-head { padding: 1.5rem 0 1.2rem; max-width: 40em; }
  .page-head p { color: var(--ink-soft); }
</style>
