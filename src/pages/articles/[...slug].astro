---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import TopicIcon from '../../components/TopicIcon.astro';
import { getCollection, render } from 'astro:content';
import { SITE, u, formatDate, isoDate } from '../../site';
import { TOPICS } from '../../topics';
import { Image, getImage } from 'astro:assets';

export async function getStaticPaths() {
  const all = await getCollection('articles');
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry, all } }));
}
const { entry, all } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const t = TOPICS[d.category];
const related = all.filter((a) => a.id !== entry.id && a.data.category === d.category).concat(all.filter((a) => a.id !== entry.id && a.data.category !== d.category)).slice(0, 3);
const ogImg = d.cover ? await getImage({ src: d.cover, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 }) : null;
const ogImage = ogImg ? new URL(ogImg.src, Astro.site).href : undefined;
const url = new URL(u(`/articles/${entry.id}/`), Astro.site).href;
const root = new URL(u('/'), Astro.site).href;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  datePublished: isoDate(d.published),
  dateModified: isoDate(d.updated ?? d.published),
  mainEntityOfPage: url,
  image: ogImage ?? new URL(u('/og.png'), Astro.site).href,
  inLanguage: 'ja',
  articleSection: d.category,
  author: { '@id': `${root}#org` },
  publisher: { '@id': `${root}#org` },
  ...(d.sources.length ? { citation: d.sources.map((s) => s.url) } : {}),
};
const toc = headings.filter((h) => h.depth === 2);
---
<Base title={d.title} description={d.description} type="article" image={d.cover} crumbs={[{ name: 'マガジン', path: '/articles/' }, { name: d.category, path: `/articles/topic/${t.slug}/` }, { name: d.title, path: `/articles/${entry.id}/` }]} jsonLd={[ld]}>
  <article class="narrow">
    <header class:list={['art-head', `tone-${t.tone}`]}>
      <a class="chip" href={u(`/articles/topic/${t.slug}/`)}><TopicIcon icon={t.icon} size={28} />{d.category}</a>
      <h1>{d.title}</h1>
      <p class="desc">{d.description}</p>
      <p class="meta">
        <time datetime={isoDate(d.published)}>{formatDate(d.published)}公開</time>
        {d.updated && <> ／ <time datetime={isoDate(d.updated)}>{formatDate(d.updated)}更新</time></>}
        ／ 文：{SITE.name}
      </p>
    </header>
    {d.cover && (
      <figure class="cover">
        <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[480, 800, 1200]} sizes="(max-width: 760px) 100vw, 760px" loading="eager" fetchpriority="high" />
      </figure>
    )}
    {toc.length > 2 && (
      <nav class="toc" aria-label="目次">
        <p>この記事の内容</p>
        <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </nav>
    )}
    <div class="prose body"><Content /></div>
    {d.sources.length > 0 && (
      <section class="sources" aria-labelledby="src-h">
        <h2 id="src-h">参考にした情報</h2>
        <ul>{d.sources.map((s) => <li><a href={s.url}>{s.name}</a></li>)}</ul>
      </section>
    )}
    <aside class="visit">
      <div class="visit-face" aria-hidden="true"></div>
      <p><strong>テンとムギの毎日を発信中。</strong><br />北九州・小倉の保護猫施設ねこの惑星で暮らす茶トラの2匹です。<a href={u('/cats/')}>テンとムギを見る</a></p>
    </aside>
  </article>
  <section class="wrap sec" aria-labelledby="rel-h">
    <div class="sec-head"><h2 id="rel-h">あわせて読みたい</h2></div>
    <div class="grid">{related.map((r) => <ArticleCard id={r.id} {...r.data} />)}</div>
  </section>
</Base>

<style>
  .art-head { margin: 1.4rem 0 1.8rem; padding: clamp(1.4rem, 4vw, 2.2rem); border-radius: var(--r-lg); background: var(--tone); }
  .chip { display: inline-flex; align-items: center; gap: .35rem; padding: .2rem .9rem .2rem .3rem; border-radius: 999px; background: var(--paper); color: var(--tone-deep); font-weight: 700; font-size: .88rem; text-decoration: none; }
  .art-head h1 { margin: .9rem 0 .7rem; font-size: clamp(1.55rem, 3.4vw, 2.15rem); }
  .desc { color: var(--ink-soft); margin-bottom: .8rem; }
  .meta { font-size: .82rem; color: var(--ink-soft); margin: 0; }
  .cover { margin: -0.6rem 0 2rem; }
  .cover img { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: var(--r-lg); display: block; }
  .body :global(img) { width: 100%; height: auto; max-height: 75vh; object-fit: cover; border-radius: var(--r-md); display: block; }
  .body :global(p:has(> img) > em) { display: block; text-align: center; font-size: .85rem; color: var(--ink-soft); font-style: normal; margin-top: .5rem; }
  .toc { background: var(--paper); border: 2px solid var(--line); border-radius: var(--r-md); padding: 1.1rem 1.4rem; margin: 0 0 2rem; }
  .toc p { font-weight: 700; margin-bottom: .3rem; }
  .toc ol { margin: 0; padding-left: 1.3em; }
  .toc li::marker { color: var(--ginger); font-weight: 700; }
  .toc a { color: var(--ink); }
  .body { max-width: none; }
  .sources { margin-top: 2.5rem; font-size: .9rem; color: var(--ink-soft); }
  .sources h2 { font-size: 1rem; }
  .visit { display: flex; gap: 1rem; align-items: center; margin-top: 2.5rem; background: var(--ginger-soft); padding: 1.2rem 1.4rem; border-radius: var(--r-md); }
  .visit p { margin: 0; }
  .visit-face { flex: none; width: 3.2rem; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #ffb466, var(--ginger) 62%, #d97520); }
  .tone-peach { --tone: var(--peach); --tone-deep: var(--peach-deep); }
  .tone-mint { --tone: var(--mint); --tone-deep: var(--mint-deep); }
  .tone-lilac { --tone: var(--lilac); --tone-deep: var(--lilac-deep); }
  .tone-sky { --tone: var(--sky); --tone-deep: var(--sky-deep); }
  .tone-rose { --tone: var(--rose); --tone-deep: var(--rose-deep); }
</style>
