---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { Image, Picture, getImage } from 'astro:assets';
import { PHOTOS, GALLERY } from '../../photos';
import type { ImageMetadata } from 'astro';
import { SITE, u, formatDate, isoDate } from '../../site';

const diary = (await getCollection('diary')).sort((a, b) => +b.data.published - +a.data.published);
const of = (name: 'テン' | 'ムギ') => diary.filter((d) => d.data.cats.includes(name)).slice(0, 3);

// TODO: 誕生日（推定）・保護された時期・好きなもの は施設で確認して追記
const cats = [
  { id: 'ten', name: 'テン', face: PHOTOS.tenFace, gallery: GALLERY['テン'], text: 'ねこの惑星の茶トラ兄弟のひとり。施設の様子はTikTokライブでもたびたび登場しています。', posts: of('テン') },
  { id: 'mugi', name: 'ムギ', face: PHOTOS.mugiFace, gallery: GALLERY['ムギ'], text: '新しいおもちゃには全力で飛びつくタイプ。夏はこまめに水を飲んで、暑さを上手に乗り切っています。', posts: of('ムギ') },
];
const abs = async (src: ImageMetadata) => new URL((await getImage({ src, width: 1200, format: 'jpg' })).src, Astro.site).href;
const faceUrl = Object.fromEntries(await Promise.all(cats.map(async (c) => [c.id, await abs(c.face.src)])));
const ld = cats.map((c) => ({
  '@context': 'https://schema.org',
  '@type': 'Thing',
  name: `${c.name}（${SITE.shortName}の茶トラ猫）`,
  description: c.text,
  image: faceUrl[c.id],
  url: new URL(u(`/cats/#${c.id}`), Astro.site).href,
}));
---
<Base title="テンとムギ｜茶トラ猫の兄弟" description="北九州・小倉の保護猫施設ねこの惑星で暮らす、茶トラのオス猫「テン」と「ムギ」の紹介ページです。性格や日々の様子、動画へのリンクをまとめています。" crumbs={[{ name: 'テンとムギ', path: '/cats/' }]} jsonLd={ld} image={PHOTOS.both.src}>
  <div class="wrap">
    <h1>テンとムギ</h1>
    <p class="prose">ねこの惑星で暮らしているのは、茶トラのオス2匹。名前はテンとムギです。ちなみに茶トラ猫にオスが多いのは、毛色を決める遺伝子の仕組みによるもの。<a href={u('/articles/chatora-osu/')}>理由はこちらの記事で解説しています</a>。</p>
    <figure class="duo">
      <Picture src={PHOTOS.both.src} alt={PHOTOS.both.alt} widths={[480, 800, 1200]} sizes="(max-width: 420px) 100vw, 24rem" formats={['avif', 'webp']} loading="eager" fetchpriority="high" />
      <figcaption>手前がムギ、奥がテン。胸と口元が白いのがムギ、全身オレンジなのがテンです。</figcaption>
    </figure>

    {cats.map((c) => (
      <section id={c.id} class="cat-sec" aria-labelledby={`${c.id}-h`}>
        <Image class="avatar" src={c.face.src} alt={c.face.alt} width={400} height={400} fit="cover" position="attention" format="webp" />
        <div class="prose">
          <h2 id={`${c.id}-h`}>{c.name}</h2>
          <table>
            <tbody>
              <tr><th scope="row">毛色</th><td>茶トラ</td></tr>
              <tr><th scope="row">性別</th><td>オス</td></tr>
              <tr><th scope="row">暮らしている場所</th><td>保護猫施設 ねこの惑星（北九州市小倉北区）</td></tr>
            </tbody>
          </table>
          <p>{c.text}</p>
          <h3>{c.name}のアルバム</h3>
          <ul class="album">
            {c.gallery.map((ph) => (
              <li><Image src={ph.src} alt={ph.alt} width={480} height={480} fit="cover" position={ph.position ?? 'attention'} format="webp" densities={[1, 2]} /></li>
            ))}
          </ul>
          {c.posts.length > 0 && (
            <>
              <h3>{c.name}の最近の日記</h3>
              <ul>
                {c.posts.map((p) => <li><time datetime={isoDate(p.data.published)}>{formatDate(p.data.published)}</time> <a href={u(`/diary/${p.id}/`)}>{p.data.title}</a></li>)}
              </ul>
            </>
          )}
        </div>
      </section>
    ))}

    <section class="prose">
      <h2>動画で会えます</h2>
      <p>2匹の毎日はTikTokとYouTubeで公開しています。過去のTikTokライブのアーカイブもYouTubeで見られます。</p>
      <ul>
        {SITE.sns.slice(0, 3).map((s) => <li><a href={s.url}>{s.name}で見る</a></li>)}
      </ul>
    </section>
  </div>
</Base>

<style>
  .cat-sec { display: grid; grid-template-columns: 12rem 1fr; gap: 2.5rem; align-items: start; margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--line); scroll-margin-top: 1rem; }
  .cat-sec h2 { margin-top: 0; }
  .duo { margin: 2rem auto 0; width: min(100%, 24rem); }
  .duo :global(img) { display: block; width: 100%; height: auto; border-radius: var(--r-lg); }
  .duo figcaption { margin-top: .6rem; text-align: center; color: var(--ink-soft); font-size: .9rem; }
  .cat-sec :global(.avatar) { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 50%; border: 6px solid var(--paper); box-shadow: 0 0 0 3px var(--ginger-soft), 0 20px 40px -24px rgba(42, 51, 99, .6); }
  .album { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr)); gap: .6rem; }
  .album li { margin: 0; }
  .album :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: var(--r-md); }
  @media (max-width: 640px) { .cat-sec { grid-template-columns: 1fr; } .cat-sec :global(.avatar) { width: 11rem; } }
</style>
