---
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { u, isoDate } from '../../site';

const diary = (await getCollection('diary')).sort((a, b) => +b.data.published - +a.data.published);
---
<Base title="テン・ムギ日記" description="保護猫施設ねこの惑星で暮らす茶トラ猫、テンとムギの日記。おもちゃで遊ぶ姿や季節の過ごし方など、2匹の毎日を記録しています。" crumbs={[{ name: '日記', path: '/diary/' }]}>
  <div class="narrow">
    <header class="page-head">
      <h1>テン・ムギ日記</h1>
      <p>施設での2匹の毎日を、ゆるく記録しています。動画はTikTokで毎日更新中。</p>
    </header>
    <ul class="days">
      {diary.map((d) => (
        <li>
          <time datetime={isoDate(d.data.published)}><span>{d.data.published.getMonth() + 1}/{d.data.published.getDate()}</span>{d.data.published.getFullYear()}</time>
          <div>
            <a href={u(`/diary/${d.id}/`)}>{d.data.title}</a>
            <p>{d.data.description}</p>
            {d.data.cats.length > 0 && <p class="who">{d.data.cats.map((c) => <span>{c}</span>)}</p>}
          </div>
          {d.data.cover && <Image class="thumb" src={d.data.cover} alt="" width={160} height={160} fit="cover" position="attention" format="webp" />}
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .page-head { padding: 1.5rem 0 1rem; }
  .page-head p { color: var(--ink-soft); }
  .days { list-style: none; padding: 0; margin: 0; display: grid; gap: .9rem; }
  .days li { position: relative; display: flex; gap: 1.2rem; align-items: center; padding: 1.1rem 1.3rem; background: var(--paper); border: 2px solid var(--line); border-radius: var(--r-md); }
  .days li:hover { border-color: var(--ginger); }
  .days time { flex: none; display: flex; flex-direction: column; align-items: center; justify-content: center; width: 4.6rem; aspect-ratio: 1; border-radius: 50%; background: var(--ginger-soft); color: var(--ginger-ink); font-size: .72rem; line-height: 1.2; }
  .days time span { font-family: var(--font-head); font-weight: 700; font-size: 1.2rem; }
  .days a { color: var(--ink); text-decoration: none; font-weight: 700; font-size: 1.05rem; }
  .days a::after { content: ''; position: absolute; inset: 0; }
  .days p { margin: .15rem 0 0; color: var(--ink-soft); font-size: .9rem; line-height: 1.7; }
  .days div { flex: 1; min-width: 0; }
  .days :global(.thumb) { flex: none; width: 5.5rem; height: 5.5rem; object-fit: cover; border-radius: var(--r-md); }
  @media (max-width: 520px) { .days :global(.thumb) { width: 3.6rem; height: 3.6rem; } .days time { width: 3.8rem; } .days li { gap: .8rem; padding: .9rem; } }
  .who { display: flex; gap: .3rem; }
  .who span { font-size: .75rem; padding: 0 .6rem; border-radius: 999px; background: var(--mint); color: var(--mint-deep); font-weight: 700; }
</style>
