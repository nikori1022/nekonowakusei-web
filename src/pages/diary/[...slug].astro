---
import MugiPlanet from '../../components/MugiPlanet.astro';
import Base from '../../layouts/Base.astro';
import { Picture, getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { SITE, u, formatDate, isoDate } from '../../site';

export async function getStaticPaths() {
  const all = (await getCollection('diary')).sort((a, b) => +a.data.published - +b.data.published);
  return all.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, prev: all[i - 1], next: all[i + 1] } }));
}
const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const root = new URL(u('/'), Astro.site).href;
const coverUrl = d.cover ? new URL((await getImage({ src: d.cover, width: 1200, format: 'jpg' })).src, Astro.site).href : null;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  datePublished: isoDate(d.published),
  mainEntityOfPage: new URL(u(`/diary/${entry.id}/`), Astro.site).href,
  image: coverUrl ?? new URL(u('/og.png'), Astro.site).href,
  author: { '@id': `${root}#org` },
  publisher: { '@id': `${root}#org` },
};
---
<Base title={`${d.title}｜テン・ムギ日記`} description={d.description} type="article" crumbs={[{ name: '日記', path: '/diary/' }, { name: d.title, path: `/diary/${entry.id}/` }]} jsonLd={[ld]} image={d.cover}>
  <article class="narrow prose page">
    <div class="post-mugi"><MugiPlanet priority={false} /></div>
    <p class="meta"><time datetime={isoDate(d.published)}>{formatDate(d.published)}</time>{d.cats.length > 0 && <>／登場：{d.cats.join('・')}</>}</p>
    <h1>{d.title}</h1>
    {d.cover && (
      <figure class="cover">
        <Picture src={d.cover} alt={d.coverAlt ?? `${d.cats.join('と')}の写真`} widths={[480, 800, 1200]} sizes="(max-width: 760px) 100vw, 720px" formats={['avif', 'webp']} loading="eager" fetchpriority="high" />
      </figure>
    )}
    <Content />
    <p class="more">動画はTikTokで毎日更新中です。<a href={SITE.sns[0].url}>TikTokを見る</a></p>
    <nav class="pager" aria-label="前後の日記">
      {prev ? <a href={u(`/diary/${prev.id}/`)}>前の日記：{prev.data.title}</a> : <span />}
      {next && <a href={u(`/diary/${next.id}/`)}>次の日記：{next.data.title}</a>}
    </nav>
  </article>
</Base>

<style>
  .meta { margin-top: 1.5rem; color: var(--ink-soft); font-size: .9rem; }
  .more { margin-top: 2rem; }
  .cover { margin: 1.2rem 0 2rem; }
  .cover :global(img) { width: 100%; height: auto; max-height: 34rem; object-fit: cover; border-radius: var(--r-lg); background: var(--ginger-soft); }
  .pager { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-top: 2.5rem; padding-top: 1rem; border-top: 1px solid var(--line); font-size: .95rem; }
  .post-mugi { width: min(15rem, 62%); margin: 1.4rem auto 1.6rem; }
</style>
