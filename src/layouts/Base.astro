---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITE, u } from '../site';

export interface Crumb { name: string; path: string }
interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  crumbs?: Crumb[];
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  /** SNSシェア用の画像（未指定なら共通の og.png） */
  image?: ImageMetadata;
}
const { title, description = SITE.description, type = 'website', crumbs = [], jsonLd = [], noindex = false, image } = Astro.props;

const isHome = Astro.url.pathname === import.meta.env.BASE_URL || Astro.url.pathname === u('/');
const fullTitle = isHome ? `${SITE.name}｜${SITE.tagline}` : `${title}｜${SITE.shortName}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const siteOg = new URL(u('/og.png'), Astro.site).href;
// ページ専用の写真があれば 1200x630 に切り抜いて OGP に使う
const ogImage = image
  ? new URL((await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 })).src, Astro.site).href
  : siteOg;
const siteRoot = new URL(u('/'), Astro.site).href;

const org = {
  '@context': 'https://schema.org',
  '@type': ['AnimalShelter', 'LocalBusiness'],
  '@id': `${siteRoot}#org`,
  name: SITE.name,
  alternateName: [SITE.shortName, 'ねこわく'],
  url: siteRoot,
  logo: new URL(u('/favicon.svg'), Astro.site).href,
  image: siteOg,
  description: SITE.description,
  foundingDate: SITE.foundingDate,
  areaServed: '北九州市',
  ...(SITE.address
    ? { address: { '@type': 'PostalAddress', streetAddress: SITE.address, addressLocality: '北九州市', addressRegion: '福岡県', addressCountry: 'JP' } }
    : { address: { '@type': 'PostalAddress', addressLocality: '北九州市小倉北区', addressRegion: '福岡県', addressCountry: 'JP' } }),
  ...(SITE.telephone ? { telephone: SITE.telephone } : {}),
  email: SITE.email,
  sameAs: SITE.sns.map((s) => s.url),
  parentOrganization: { '@type': 'Organization', name: SITE.operator.name, url: SITE.operator.url },
};
const breadcrumb = crumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ name: 'ホーム', path: '/' }, ...crumbs].map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name,
        item: new URL(u(c.path), Astro.site).href,
      })),
    }
  : null;
const schemas = [org, ...(breadcrumb ? [breadcrumb] : []), ...jsonLd];

const nav = [
  { name: 'テンとムギ', path: '/cats/' },
  { name: '日記', path: '/diary/' },
  { name: 'マガジン', path: '/articles/' },
  { name: '北九州の保護猫', path: '/kitakyushu/' },
  { name: '施設について', path: '/about/' },
];
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content="#1e2a55" />
  <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
  <link rel="sitemap" href={u('/sitemap-index.xml')} />
  <link rel="alternate" type="application/rss+xml" title={`${SITE.shortName}の新着`} href={u('/rss.xml')} />

  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="ja_JP" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@nekowaku_kokura" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@500;700&display=swap" />

  {import.meta.env.PROD && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaId}`}></script>
      <script is:inline define:vars={{ gaId: SITE.gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', gaId);
      </script>
    </>
  )}
  {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</head>
<body>
  <a class="skip" href="#main">本文へ移動</a>
  <header class="site-head">
    <div class="wrap head-row">
      <a class="logo" href={u('/')}>
        <img src={u('/favicon.svg')} alt="" width="40" height="40" />
        <span class="logo-text"><small>北九州・小倉の保護猫施設</small>ねこの惑星</span>
      </a>
      <nav aria-label="メインメニュー">
        <ul>
          {nav.map((n) => (
            <li><a href={u(n.path)} aria-current={Astro.url.pathname.startsWith(u(n.path)) ? 'page' : undefined}>{n.name}</a></li>
          ))}
        </ul>
      </nav>
      <a class="visit" href={u('/join/')}>利用者募集</a>
    </div>
  </header>

  {crumbs.length > 0 && (
    <nav class="wrap crumbs" aria-label="パンくずリスト">
      <ol>
        <li><a href={u('/')}>ホーム</a></li>
        {crumbs.map((c, i) => (
          <li>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={u(c.path)}>{c.name}</a>}</li>
        ))}
      </ol>
    </nav>
  )}

  <main id="main">
    <slot />
  </main>

  <footer class="site-foot">
    <div class="wrap foot-grid">
      <div>
        <p class="foot-name"><img src={u('/favicon.svg')} alt="" width="32" height="32" />{SITE.name}</p>
        <p>{SITE.area}<br />運営：<a href={SITE.operator.url}>{SITE.operator.name}</a></p>
        <p>お問い合わせ：<a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      </div>
      <div>
        <p class="foot-h">SNSで毎日の様子を発信中</p>
        <ul class="pills">
          {SITE.sns.map((s) => <li><a href={s.url} rel="me noopener">{s.name}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="foot-h">サイト内</p>
        <ul class="links">
          {nav.map((n) => <li><a href={u(n.path)}>{n.name}</a></li>)}
          <li><a href={u('/join/')}>就労支援施設をお探しの方へ</a></li>
        </ul>
      </div>
    </div>
    <p class="wrap copy">© {new Date().getFullYear()} {SITE.name}</p>
  </footer>
</body>
</html>

<style>
  .site-head { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,.88); backdrop-filter: saturate(1.4) blur(10px); border-bottom: 1px solid var(--line); }
  .head-row { display: flex; align-items: center; gap: 1.2rem; padding-block: .6rem; }
  .logo { display: flex; align-items: center; gap: .6rem; text-decoration: none; color: var(--ink); margin-right: auto; }
  .logo-text { display: flex; flex-direction: column; font-family: var(--font-head); font-weight: 700; font-size: 1.35rem; line-height: 1.15; letter-spacing: .08em; }
  .logo-text small { font-size: .62rem; font-weight: 500; color: var(--ink-soft); letter-spacing: .06em; }
  .site-head ul { display: flex; gap: .2rem; list-style: none; margin: 0; padding: 0; font-size: .92rem; }
  .site-head nav a { display: block; color: var(--ink); text-decoration: none; padding: .45rem .85rem; border-radius: 999px; font-weight: 500; }
  .site-head nav a:hover { background: #f3f0fc; }
  .site-head nav a[aria-current='page'] { background: var(--ginger-soft); color: var(--ginger-ink); font-weight: 700; }
  .visit { flex: none; background: var(--ginger); color: var(--ink); font-weight: 700; font-size: .92rem; padding: .55rem 1.1rem; border-radius: 999px; text-decoration: none; }
  .visit:hover { background: #e47f29; }
  @media (max-width: 900px) {
    .head-row { flex-wrap: wrap; row-gap: .3rem; }
    .site-head nav { order: 3; width: 100%; overflow-x: auto; scrollbar-width: none; }
    .site-head ul { width: max-content; }
    .site-head nav a { padding: .35rem .75rem; font-size: .88rem; }
  }

  .crumbs ol { list-style: none; display: flex; flex-wrap: wrap; gap: .3rem; padding: 1.1rem 0 0; margin: 0; font-size: .8rem; color: var(--ink-soft); }
  .crumbs li + li::before { content: '›'; margin-right: .3rem; }
  .crumbs a { color: var(--ink-soft); }

  .site-foot { margin-top: clamp(4rem, 9vw, 7rem); padding-top: 2.5rem; background: var(--paper); border-top: 1px solid var(--line); font-size: .92rem; }
  .foot-grid { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); padding-bottom: 1rem; }
  .foot-name { display: flex; align-items: center; gap: .5rem; font-family: var(--font-head); font-weight: 700; font-size: 1.15rem; margin-bottom: .5rem; }
  .foot-h { font-weight: 700; margin-bottom: .6rem; }
  .pills { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .45rem; }
  .pills a { display: inline-block; padding: .3rem .85rem; border-radius: 999px; background: #f3f0fc; color: var(--ink); text-decoration: none; font-size: .85rem; }
  .pills a:hover { background: var(--ginger-soft); color: var(--ginger-ink); }
  .links { list-style: none; padding: 0; margin: 0; columns: 2; }
  .links a { color: var(--ink); text-decoration: none; line-height: 2.1; }
  .links a:hover { color: var(--ginger-ink); text-decoration: underline; }
  .copy { margin: 0 auto; padding: 1.2rem 0 2rem; font-size: .78rem; color: var(--ink-soft); border-top: 1px solid var(--line); }
</style>
