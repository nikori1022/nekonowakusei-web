---
import TopicIcon from './TopicIcon.astro';
import { TOPICS, type TopicName } from '../topics';
import { u, formatDate, isoDate } from '../site';

interface Props { level?: 2 | 3; id: string; title: string; description: string; category: TopicName; published: Date; base?: 'articles' | 'diary' }
const { level = 3, id, title, description, category, published, base = 'articles' } = Astro.props;
const t = TOPICS[category];
---
<article class:list={['card', `tone-${t.tone}`]}>
  <div class="top">
    <span class="chip"><TopicIcon icon={t.icon} size={26} />{category}</span>
    <time datetime={isoDate(published)}>{formatDate(published)}</time>
  </div>
  {level === 2 ? <h2 class="h"><a href={u(`/${base}/${id}/`)}>{title}</a></h2> : <h3 class="h"><a href={u(`/${base}/${id}/`)}>{title}</a></h3>}
  <p>{description}</p>
</article>

<style>
  .card { position: relative; display: flex; flex-direction: column; gap: .6rem; padding: 1.4rem 1.4rem 1.5rem; background: var(--paper); border-radius: var(--r-md); border: 2px solid var(--line); transition: transform .15s, border-color .15s; }
  .card:hover { transform: translateY(-3px); border-color: var(--tone-deep); }
  .card:focus-within { border-color: var(--tone-deep); }
  .top { display: flex; align-items: center; justify-content: space-between; gap: .5rem; font-size: var(--fs-sm); }
  .chip { display: inline-flex; align-items: center; gap: .35rem; padding: .15rem .7rem .15rem .25rem; border-radius: 999px; background: var(--tone); color: var(--tone-deep); font-weight: 700; }
  time { color: var(--ink-soft); }
  .h { margin: .2rem 0 0; font-size: 1.12rem; line-height: 1.6; }
  .h a { color: var(--ink); text-decoration: none; }
  .h a::after { content: ''; position: absolute; inset: 0; border-radius: var(--r-md); }
  p { margin: 0; color: var(--ink-soft); font-size: .93rem; line-height: 1.8; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .tone-peach { --tone: var(--peach); --tone-deep: var(--peach-deep); }
  .tone-mint { --tone: var(--mint); --tone-deep: var(--mint-deep); }
  .tone-lilac { --tone: var(--lilac); --tone-deep: var(--lilac-deep); }
  .tone-sky { --tone: var(--sky); --tone-deep: var(--sky-deep); }
  .tone-rose { --tone: var(--rose); --tone-deep: var(--rose-deep); }
</style>
