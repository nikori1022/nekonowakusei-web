---
// トピックの丸いアイコン。猫の耳つきの丸に、トピックを表す小さな記号が入る。
interface Props { icon: 'house' | 'bowl' | 'spark' | 'pin' | 'heart'; size?: number }
const { icon, size = 44 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 48 48" aria-hidden="true" class="ti">
  <path d="M8 18 L10 4 L20 12 Z M40 18 L38 4 L28 12 Z" fill="currentColor" />
  <circle cx="24" cy="26" r="19" fill="currentColor" />
  <g fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
    {icon === 'house' && <path d="M15 27 L24 19 L33 27 M18 25 V34 H30 V25 M22 34 V29 H26 V34" />}
    {icon === 'bowl' && <><path d="M14 26 H34 Q33 34 24 34 Q15 34 14 26 Z" /><path d="M20 22 q2 -3 4 0 q2 3 4 0" /></>}
    {icon === 'spark' && <path d="M24 16 V20 M24 32 V36 M14 26 H18 M30 26 H34 M17 19 L20 22 M28 30 L31 33 M31 19 L28 22 M20 30 L17 33" />}
    {icon === 'pin' && <><path d="M24 36 C18 29 16 26 16 23 A8 8 0 0 1 32 23 C32 26 30 29 24 36 Z" /><circle cx="24" cy="23" r="2.6" /></>}
    {icon === 'heart' && <path d="M24 34 C17 29 14 26 14 22 A5 5 0 0 1 24 20 A5 5 0 0 1 34 22 C34 26 31 29 24 34 Z" />}
  </g>
</svg>
<style>.ti { flex: none; }</style>
